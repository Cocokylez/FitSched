generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  exercises               Exercise[]
  onboardingCompleted     Boolean                  @default(false)
  fitnessGoal             String?
  experienceLevel         String?
  workoutsPerWeek         Int?
  workoutEnvironment      String?
  heightCm                Float?
  weightKg                Float?
  bmi                     Float?
  hasInjury               Boolean                  @default(false)
  injuryNotes             String?
  calendarConnections     CalendarConnection[]
  pushSubscriptions       PushSubscription[]
  chatMessages            ChatMessage[]
  workoutSchedules        WorkoutSchedule[]
  workoutSessionLogs      WorkoutSessionLog[]
  streakMilestones        StreakMilestone[]
  fitTokens               FitToken[]
  fitTokenBalance         FitTokenBalance?
  tokenVersion            Int                      @default(0)
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  hikeLogs                HikeLog[]
  weightLogs              WeightLog[]
  workoutTemplates        WorkoutTemplate[]
  achievements            UserAchievement[]
  streakFreezeArmed       Boolean                  @default(false)
  ftBoostArmed            Boolean                  @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  CORE
  ARMS
  FULL_BODY
  CARDIO
  REST
}

enum Equipment {
  BODYWEIGHT
  DUMBBELLS
  BARBELL
  MACHINE
  CABLES
  BANDS
  KETTLEBELL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Exercise {
  id          String      @id @default(cuid())
  userId      String?
  name        String
  description String?
  muscleGroup MuscleGroup
  equipment   Equipment   @default(BODYWEIGHT)
  difficulty  Difficulty  @default(BEGINNER)
  isSystem    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([muscleGroup])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model CalendarConnection {
  id           String    @id @default(cuid())
  userId       String
  googleToken  String
  refreshToken String
  tokenExpiry  DateTime
  calendarId   String    @default("primary")
  lastSyncedAt DateTime?
  connectedAt  DateTime  @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([userId, calendarId])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  connectionId  String
  googleEventId String
  summary       String
  startTime     DateTime
  endTime       DateTime
  isAllDay      Boolean  @default(false)
  syncedAt      DateTime @default(now())

  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([startTime])
  @@index([connectionId, startTime])
}

model WorkoutSchedule {
  id          String   @id @default(cuid())
  userId      String
  date        String
  workoutName String
  exercises   Json
  source      String   @default("ai")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model WorkoutSessionLog {
  id          String     @id @default(cuid())
  userId      String
  date        String
  workoutName String
  exercises   Json
  notes       String?
  completedAt DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitTokens   FitToken[]

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model FitToken {
  id           String   @id @default(cuid())
  userId       String
  amount       Decimal  @db.Decimal(10, 2)
  reason       String
  workoutLogId String
  createdAt    DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLog WorkoutSessionLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutLogId, reason])
  @@index([userId])
  @@index([workoutLogId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model FitTokenBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StreakMilestone {
  id         String   @id @default(cuid())
  userId     String
  milestone  Int
  achievedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestone])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HikeLog {
  id           String   @id @default(cuid())
  userId       String
  name         String   @default("Hike")
  distanceKm   Float
  durationMin  Int
  elevationM   Int?
  locationName String?
  routePoints  Json?
  notes        String?
  loggedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@index([userId, loggedAt])
}

model SecurityLog {
  id        String   @id @default(cuid())
  event     String
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  weightKg Float
  notes    String?
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@index([userId, loggedAt])
}

model WorkoutTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  exercises Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  type       String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}
